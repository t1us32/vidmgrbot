# Скопируйте в .env и заполните. .env не коммитить.

# Токен от @BotFather
BOT_TOKEN=

# ID групп, где бот работает (через запятую). Остальные чаты игнорируются.
ALLOWED_CHAT_IDS=-1001234567890

# ID бота-загрузчика (USaver и т.п.), через запятую. Узнать: запустите с DRY_RUN=1, отправьте ссылку TikTok, найдите строку «Сообщение от бота id=...» в actions.log
COMPANION_BOT_IDS=

# ID админов, которые могут /pause /resume /status /chatid (через запятую)
ADMIN_IDS=

# 1 = только лог, ничего не удаляется. Сначала проверьте в 1, потом переключите на 0
DRY_RUN=1
